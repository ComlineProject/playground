{
  "name": "comline-web-kit",
  "version": "0.1.0",
  "description": "The playground's editor and simulate view, for the playground, the tutorial and other Comline web pages.",
  "private": true,
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ComlineProject/playground.git",
    "directory": "kit"
  },
  "type": "module",
  "exports": {
    "./sim": "./src/sim/index.ts",
    "./sim.css": "./src/sim/sim.css",
    "./editor": "./src/editor/index.ts",
    "./editor-wasm": "./pkg-editor/comline_playground_wasm.js",
    "./editor-wasm/bg.wasm": "./pkg-editor/comline_playground_wasm_bg.wasm"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "pkg-editor",
    "scripts"
  ],
  "scripts": {
    "wasm": "wasm-pack build ../wasm --release --target web --out-dir ../kit/pkg-editor --out-name comline_playground_wasm",
    "prepack": "bash scripts/prepare.sh",
    "test": "tsc -p tsconfig.test.json && node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.7.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.34.0",
    "@lezer/highlight": "^1.2.3",
    "comline-simulator": "git+https://github.com/ComlineProject/simulator.git#564851a8fa00709cd94db8ce8ab1c4325a691fc4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "linkedom": "^0.18.13",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
